{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shelfy",
  "version": "0.1.0",
  "identifier": "dev.ktama.shelfy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shelfy",
        "width": 800,
        "height": 500,
        "minWidth": 560,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,BackForwardCache --disable-gpu --disable-gpu-compositing --renderer-process-limit=1 --js-flags=--max-old-space-size=64"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
